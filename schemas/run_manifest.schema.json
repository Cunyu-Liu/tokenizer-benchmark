{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/run_manifest.schema.json",
  "title": "TokBench-RNA run_manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "parent_run_id", "goal_hash", "source_commit",
    "resolved_config", "dataset_split_tokenizer_hash", "seed",
    "gpu_uuid", "param_count", "valid_nt_exposure", "flops",
    "checkpoint_output_hash", "state", "failure_reason"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "parent_run_id": {"type": ["string","null"]},
    "goal_hash": {"type": "string"},
    "source_commit": {"type": "string"},
    "resolved_config": {"type": "object"},
    "dataset_split_tokenizer_hash": {"type": "object"},
    "seed": {"type": "integer"},
    "gpu_uuid": {"type": "string"},
    "param_count": {"type": "integer"},
    "valid_nt_exposure": {"type": "integer"},
    "flops": {"type": "number"},
    "checkpoint_output_hash": {"type": "string"},
    "state": {"type": "string", "enum": ["NOT_RUN","DEVELOPMENT_ONLY","PASS_CLOSED","FAIL_CLOSED_WITH_EVIDENCE","BLOCKED_EXTERNAL_WITH_EVIDENCE","TERMINATED_SAFELY_WITH_EVIDENCE","REDIRECT_PENDING_OWNER_APPROVAL"]},
    "failure_reason": {"type": ["string","null"]}
  }
}